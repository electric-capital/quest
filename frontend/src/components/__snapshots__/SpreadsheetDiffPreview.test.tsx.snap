// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SpreadsheetDiffPreview > renders a grid-only (spreadsheet) diff byte-identically 1`] = `"<div class="sheet-diff-scroll"><table class="sheet-diff-table"><thead><tr><th class="sheet-diff-corner"></th><th class="sheet-diff-col-label">A</th><th class="sheet-diff-col-label in-target">B</th><th class="sheet-diff-col-label in-target">C</th><th class="sheet-diff-col-label">D</th></tr></thead><tbody><tr><th class="sheet-diff-row-label">1</th><td class="sheet-diff-cell context" title="a1">a1</td><td class="sheet-diff-cell context" title="b1">b1</td><td class="sheet-diff-cell context" title="c1">c1</td><td class="sheet-diff-cell context" title="d1">d1</td></tr><tr><th class="sheet-diff-row-label in-target">2</th><td class="sheet-diff-cell context" title="a2">a2</td><td class="sheet-diff-cell target changed"><span class="sheet-diff-old" title="old">old</span><span class="sheet-diff-new" title="new">new</span></td><td class="sheet-diff-cell target unchanged" title="same">same</td><td class="sheet-diff-cell context" title="d2">d2</td></tr><tr><th class="sheet-diff-row-label in-target">3</th><td class="sheet-diff-cell context" title="a3">a3</td><td class="sheet-diff-cell target changed"><span class="sheet-diff-new" title="added">added</span></td><td class="sheet-diff-cell target changed"><span class="sheet-diff-old" title="gone">gone</span><span class="sheet-diff-new" title="">(empty)</span></td><td class="sheet-diff-cell context" title="d3">d3</td></tr><tr><th class="sheet-diff-row-label">4</th><td class="sheet-diff-cell context" title="a4">a4</td><td class="sheet-diff-cell context" title="b4">b4</td><td class="sheet-diff-cell context" title="c4">c4</td><td class="sheet-diff-cell context" title="d4">d4</td></tr></tbody></table><div class="sheet-diff-legend"><span class="sheet-diff-legend-item"><span class="sheet-diff-swatch changed"></span> changing</span><span class="sheet-diff-legend-item"><span class="sheet-diff-swatch unchanged"></span> rewritten, same value</span><span class="sheet-diff-legend-item"><span class="sheet-diff-swatch context"></span> context</span></div></div>"`;
