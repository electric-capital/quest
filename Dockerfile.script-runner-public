# Public-project sandbox image. A SEPARATE image from Dockerfile.script-runner
# (not a mode switch) so the tooling in each can be customized independently:
# this one leans toward internet workloads (fetching, scraping, API clients),
# the restricted one toward internal-data processing.
FROM python:3.12-slim

# Bump this date to make every deployment rebuild the image from fresh layers
# the next time run.py starts: a newer python:3.12-slim base (run.py pulls it
# before a rebuild), current Debian packages and current pip packages, e.g.
# after a security fix in the base image, ca-certificates or certifi. run.py
# rebuilds when this file changes, but podman would otherwise reuse every
# cached layer because no instruction below changed; a changed ARG value
# used in the LABEL invalidates the cache from here down.
ARG QUEST_IMAGE_REVISION=2026-10-23
LABEL org.quest.image-revision=${QUEST_IMAGE_REVISION}

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl wget jq bash iptables zip unzip ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir requests httpx beautifulsoup4 lxml openpyxl python-docx matplotlib seaborn pypdf PyPDFForm

# LibreOffice (headless, no GUI toolkit) plus fonts, for high-fidelity
# document conversion inside the sandbox (Word / ODT / RTF / HTML -> PDF and
# the other LibreOffice formats, also xlsx / pptx -> PDF). The system prompt
# and the system:workspace skill steer the model here for every document
# conversion instead of stitching PDFs together from python-docx output.
#
# Fonts: the metric-compatible clones LibreOffice substitutes automatically
# (Carlito for Calibri, Caladea for Cambria, Liberation for Arial / Times New
# Roman / Courier New) plus DejaVu and Noto for coverage. Microsoft's "Core
# fonts for the Web" (Arial, Times New Roman, Courier New, Verdana, Georgia,
# Trebuchet MS, Comic Sans MS, Impact, Andale Mono, Webdings) are
# EULA-redistributable and downloaded at build time by the `contrib` package
# ttf-mscorefonts-installer; the Office-era fonts (Calibri, Cambria, Segoe UI,
# Aptos, ...) are not redistributable, hence the clones. A build host without
# egress to the fonts' download mirror still succeeds with the clones only.
RUN sed -i 's/ main$/ main contrib/' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        libreoffice-writer-nogui libreoffice-calc-nogui libreoffice-impress-nogui \
        fontconfig fonts-crosextra-carlito fonts-crosextra-caladea \
        fonts-liberation fonts-liberation2 fonts-dejavu fonts-noto-core && \
    ( echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" | debconf-set-selections && \
      apt-get install -y --no-install-recommends ttf-mscorefonts-installer \
      || echo "WARNING: Microsoft core fonts not installed (download failed?); continuing with the metric-compatible clones only" ) && \
    rm -rf /var/lib/apt/lists/* && \
    fc-cache -f

# `soffice` wrapper that seeds a per-run copy of a pre-built LibreOffice
# user profile (first-start profile creation costs ~1-2 s per container
# otherwise; HOME is a fresh /tmp on every run). The warm-up conversion
# below creates the profile at image build time.
COPY script-runner-soffice.sh /usr/local/bin/soffice
RUN chmod +x /usr/local/bin/soffice && ln -s soffice /usr/local/bin/libreoffice && \
    mkdir -p /opt/libreoffice-profile && echo "warm-up" > /tmp/warm-up.txt && \
    LIBREOFFICE_PROFILE_DIR=/opt/libreoffice-profile \
        soffice --headless --convert-to pdf --outdir /tmp /tmp/warm-up.txt >/dev/null && \
    rm -f /tmp/warm-up.txt /tmp/warm-up.pdf && chmod -R a+rX /opt/libreoffice-profile

ENV MPLBACKEND=Agg

# Pre-build matplotlib's font cache at image build time. Containers run with
# a fresh HOME=/tmp, so without this every run that imports matplotlib
# rebuilds fontlist.json from scratch (~1.2s). The directory must stay
# writable: matplotlib falls back to a throwaway temp dir (and rebuilds)
# when MPLCONFIGDIR is not writable by the unprivileged run user.
ENV MPLCONFIGDIR=/opt/matplotlib
RUN python3 -c "import matplotlib.pyplot" && chmod -R a+rwX /opt/matplotlib

# Entrypoint script that opens internet egress while REJECTing all private /
# link-local destinations (LAN, cloud metadata service), then drops
# privileges. No socat proxy bridge: public containers have no path -- and
# no credential -- to the Quest API.
COPY script-runner-entry-public.sh /usr/local/bin/script-runner-entry-public.sh
RUN chmod +x /usr/local/bin/script-runner-entry-public.sh

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/script-runner-entry-public.sh"]
CMD ["python3"]
